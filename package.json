{
  "name": "@booi-gg/medea",
  "version": "0.1.0",
  "bin": {
    "medea": "./dist/start.js"
  },
  "files": [
    "dist",
    "native"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/start.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "test": "node --test",
    "menubar:start": "node src/start.js start",
    "menubar:stop": "node src/start.js stop",
    "menubar:status": "node src/start.js status",
    "menubar:sign": "node src/start.js sign",
    "typecheck": "tsc",
    "check": "vp check",
    "format": "vp fmt",
    "lint": "vp lint"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "^1.8.1",
    "emphasize": "^7.0.0",
    "match-sorter": "8.3.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.1"
  }
}
