{
  "name": "@booi-gg/redhot",
  "version": "0.6.2",
  "description": "A keyboard launcher for macOS that runs in your terminal: apps, hotkeys, quicklinks, clipboard history and window actions",
  "keywords": [
    "cast",
    "cli",
    "clipboard-history",
    "hotkeys",
    "launcher",
    "macos",
    "quicklinks",
    "ray",
    "terminal",
    "window-manager"
  ],
  "homepage": "https://github.com/booi-gg/proj-redhot#readme",
  "bugs": {
    "url": "https://github.com/booi-gg/proj-redhot/issues"
  },
  "license": "MIT",
  "author": "booi-gg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/booi-gg/proj-redhot.git"
  },
  "bin": {
    "redhot": "./dist/start.js"
  },
  "files": [
    "dist",
    "native"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/start.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "release": "pnpm check && pnpm typecheck && pnpm test && node scripts/bump-version.ts",
    "test": "node --test",
    "menubar:start": "node src/start.js start",
    "menubar:stop": "node src/start.js stop",
    "menubar:restart": "node src/start.js restart",
    "menubar:status": "node src/start.js status",
    "menubar:sign": "node src/start.js sign",
    "typecheck": "tsc",
    "check": "vp check",
    "format": "vp fmt",
    "lint": "vp lint",
    "prepare": "vp config"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "^1.8.1",
    "emphasize": "^7.0.0",
    "match-sorter": "8.3.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.1"
  }
}
